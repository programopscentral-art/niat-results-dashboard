# ---- Supabase (service role — server only, NEVER ship to browser) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Google service account (share the spreadsheet with this email, viewer) ----
GOOGLE_CLIENT_EMAIL=niat-sync@your-project.iam.gserviceaccount.com
# Paste the full private key; keep the \n escapes on one line, or use a multiline secret in Railway.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Webhook auth (must match the Apps Script SECRET) ----
SYNC_WEBHOOK_SECRET=generate-a-long-random-string

# ---- Tuning ----
PORT=8080
RECONCILE_CRON=*/1 * * * *          # how often to poll (default: every minute)
PASS_MARK_PCT=40
TAB_DENYLIST=Sheet10,Sheet11,Sheet12,{University_Copy this sheet and make your subshet}

# ---- Dynamic discovery (cron-only mode) ----
# ON by default: any spreadsheet SHARED WITH THE SERVICE ACCOUNT whose title matches
# the pattern below is auto-registered & synced — no manual onboarding per semester.
# Requires the Google Drive API enabled on the GCP project.
AUTO_DISCOVER=true
# Regex with 2 capture groups: (batch year)(semester number).
SHEET_TITLE_REGEX=Batch\s*(\d{4})[^\d]*Semester\s*(\d+)
